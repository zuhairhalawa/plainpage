{
  "name": "plainpage",
  "version": "0.1.0",
  "description": "Turn a photo of a worksheet into a page every learner can read",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && tsc --noEmit -p functions && vite build",
    "test": "vitest run",
    "eval": "node --experimental-strip-types eval/run.ts",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-11-01"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.19.2",
    "axe-core": "^4.11.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.2.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true,
    "tesseract.js": false
  }
}
